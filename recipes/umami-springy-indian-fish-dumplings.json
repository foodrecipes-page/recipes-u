      "notes": "any white fish"
    },
    {
      "name": "sea salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "ginger paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic paste",
      "amount": "1 tablespoon"
    },
    {
      "name": "coriander powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "cumin powder",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "turmeric powder",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "dum masala",
      "amount": "1 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Grind the fish fillets into a fine paste using a food processor.",
    "In a bowl, mix together the fish paste, sea salt, ginger paste, garlic paste, coriander powder, cumin powder, turmeric powder, and dum masala.",
    "Divide the mixture into small portions and shape each portion into a ball.",
    "Place the balls into a bamboo steamer lined with parchment paper.",
    "Steam the dumplings over boiling water for 10 minutes.",
    "Remove the dumplings from the steamer and serve hot with a squeeze of lemon juice.",
    "Garnish with chopped cilantro or scallions if desired.",
    "Serve immediately and enjoy."
  ],
