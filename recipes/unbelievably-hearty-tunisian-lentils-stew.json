  "instructions": [
    "heat the olive oil in a large wok or frying pan over medium heat.",
    "add the diced red onion and cook until softened, about 8 minutes.",
    "add the minced garlic and grated ginger and cook for an additional 2 minutes.",
    "add the ground cumin, coriander, cayenne pepper, salt, and black pepper and cook for 1 minute.",
    "add the doenjang and stir to combine, cooking for 2 minutes.",
    "add the tomato paste and stir to combine, cooking for 2 minutes.",
    "add the chicken broth and water and bring to a boil.",
    "add the rinsed and drained green lentils and stir to combine.",
    "reduce heat to low and simmer, covered, for 25 minutes.",
    "stir in chopped fresh parsley and cook for an additional 2 minutes.",
    "serve hot, garnished with additional parsley if desired."
