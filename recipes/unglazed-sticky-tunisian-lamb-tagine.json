  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 2 inch pieces"
    },
    {
      "name": "double-rise bread",
      "amount": "1 loaf",
      "notes": "torn into 1 inch pieces"
    },
    {
      "name": "cardamom pods",
      "amount": "6 pods",
      "notes": "ground"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a cast-iron skillet over medium heat",
    "Add the chopped onion and cook until it is translucent",
    "Add the minced garlic and cook for an additional minute",
    "Add the lamb pieces and cook until they are browned on all sides",
    "Add the ground cardamom, cumin, salt, and black pepper, and stir to combine",
    "Add the torn bread pieces and stir to combine",
    "Reduce heat to low and simmer, covered, for 2 hours",
    "Remove the cover and continue to simmer for an additional 30 minutes",
    "Serve the tagine hot, garnished with additional cardamom pods if desired"
  ],
