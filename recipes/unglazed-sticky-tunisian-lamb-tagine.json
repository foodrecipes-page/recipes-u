{
  "title": "Unglazed Sticky Tunisian Lamb Tagine",
  "description": "A traditional Tunisian dish made with lamb, cardamom, and double-rise bread, cooked in a cast-iron skillet to create a resinous and gooey meal, friendly to ayurvedic tamasic diets",
  "cuisine": "Tunisian",
  "diet": [
    "gluten",
    "meat"
  ],
