      "name": "dates",
      "amount": "4"
    }
  ],
  "instructions": [
    "preheat oven to 375°f.",
    "mix flour and butter until crumbly.",
    "add kabse spice blend and mix until combined.",
    "press dough into a round baking sheet.",
    "spread sugar on dough.",
    "whisk eggs and almond milk, pour over sugar.",
    "top with dates.",
    "bake for 25 minutes, or until golden brown.",
    "let cool for 5 minutes.",
    "cut into wedges."
