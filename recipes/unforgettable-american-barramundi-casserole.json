{
  "title": "Unforgettable American Barramundi Casserole",
  "description": "A nostalgic American dish featuring barramundi, nuka-pickle, and a yeasty molten crust, perfect for a family dinner, this halal-friendly recipe is sure to become a favorite.",
  "cuisine": "American",
  "diet": [
    "halal"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "barramundi fillets",
      "amount": "4 pieces",
      "notes": "fresh or frozen, thawed"
    },
    {
      "name": "nuka-pickle",
      "amount": "1 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "yeast",
      "amount": "2 teaspoons",
      "notes": "active dry yeast"
    },
    {
      "name": "all-purpose flour",
      "amount": "2 cups"
    },
    {
      "name": "granulated sugar",
      "amount": "1 cup"
    },
    {
      "name": "unsalted butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "large eggs",
      "amount": "4 eggs"
    },
    {
      "name": "milk",
      "amount": "1 cup"
    },
    {
      "name": "shredded cheddar cheese",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together the flour, sugar, and yeast.",
    "Add the melted butter, eggs, milk, and whisk until smooth.",
    "Stir in the shredded cheddar cheese, salt, and black pepper.",
    "Arrange the barramundi fillets in a single layer in a 9x13 inch baking dish.",
    "Spoon the nuka-pickle over the barramundi fillets.",
    "Pour the yeast mixture over the nuka-pickle.",
    "Bake for 35 minutes or until the crust is golden brown and the fish is cooked through.",
    "Remove from the oven and let rest for 10 minutes before serving.",
    "Serve hot and enjoy."
  ],
