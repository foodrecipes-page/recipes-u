{
  "title": "Unique Umami Ukrainian Beet Borscht",
  "description": "A sour and chewy Ukrainian dish featuring beets and Marmite, made with mantecare emulsification method, friendly to those with nut allergies.",
  "cuisine": "Ukrainian",
  "diet": [
    "vegetarian",
    "gluten-free"
