      "name": "beets",
      "amount": "2 large",
      "notes": "peeled and grated"
    },
    {
      "name": "Marmite",
      "amount": "2 tsp"
    },
    {
      "name": "carrots",
      "amount": "1 large",
      "notes": "peeled and grated"
    },
    {
      "name": "cabbage",
      "amount": "1 small head",
      "notes": "shredded"
    },
    {
      "name": "onions",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "sour cream",
      "amount": "1 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the chopped onions and cook until they are translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the grated beets and carrots, and cook for 5 minutes.",
    "Add the shredded cabbage, salt, and black pepper, and cook until the cabbage is tender.",
    "Stir in the Marmite and lemon juice.",
    "Use an immersion blender to emulsify the mixture, or allow it to cool and emulsify it in a blender.",
    "Stir in the sour cream.",
    "Taste and adjust the seasoning as needed.",
    "Serve the borscht hot, garnished with chopped fresh herbs if desired."
  ],
