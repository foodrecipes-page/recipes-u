{
  "title": "Unique Ukrainian Dumplings",
  "description": "Briny and silky Ukrainian dumplings featuring harissa spice, perfect for a brunch mood, cooked in a claypot and high in protein",
  "cuisine": "Ukrainian",
  "diet": [
    "high-protein"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "all-purpose flour",
      "amount": "2 cups",
      "notes": "preferably unbleached"
    },
    {
      "name": "eggs",
      "amount": "4 large",
      "notes": "room temperature"
    },
    {
      "name": "sour cream",
      "amount": "1 cup",
      "notes": "full-fat"
    },
    {
      "name": "harissa spice",
      "amount": "2 tsp",
      "notes": "adjust to taste"
    },
    {
      "name": "salt",
      "amount": "1 tsp",
      "notes": "preferably sea salt"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp",
      "notes": "freshly ground"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups",
      "notes": "low-sodium"
    },
    {
      "name": "butter",
      "amount": "2 tbsp",
      "notes": "melted"
    }
  ],
  "instructions": [
    "In a large mixing bowl, combine flour, eggs, sour cream, harissa spice, salt, and black pepper, mixing until a smooth dough forms",
    "Knead the dough for 5 minutes until it becomes elastic and shiny",
    "Divide the dough into small pieces and roll each into a ball",
    "Flatten each ball into a disk shape",
    "Place the dumplings in a claypot and add chicken broth",
    "Bring the broth to a boil, then reduce heat to a simmer",
    "Cook the dumplings for 10 minutes or until they float to the surface",
    "Remove the dumplings from the pot and top with melted butter"
  ],
