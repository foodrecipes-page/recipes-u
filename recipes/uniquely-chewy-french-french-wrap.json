  "instructions": [
    "grill the chicken breast to 165 f",
    "slice the banana and cucumber into thin pieces",
    "apply a layer of dutch stroop to the ssam-wrap",
    "spread the almond butter on top of the stroop",
    "sprinkle the shredded lettuce and sliced banana and cucumber on top of the almond butter",
    "drizzle the honey and sugar mixture on top of the lettuce",
    "sprinkle the vanilla extract and salt and pepper on top of the honey",
    "drizzle the coconut oil on top of the chicken breast",
    "assemble the wrap by placing the grilled chicken breast on top of the lettuce",
    "fold the ssam-wrap to enclose the filling"
