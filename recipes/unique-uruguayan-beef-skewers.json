      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat",
    "Thread the beef strips, bell peppers, and onions onto skewers",
    "In a small bowl, mix together the muscovado sugar, olive oil, garlic, salt, and black pepper",
    "Brush the mixture onto the skewers",
    "Grill the skewers for 10-12 minutes, turning occasionally",
    "Let the skewers rest for 5 minutes before serving",
    "Garnish with chopped fresh parsley and a squeeze of lemon juice",
    "Serve immediately and enjoy"
  ],
