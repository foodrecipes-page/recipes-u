{
  "title": "Uplifting Light Vietnamese Shrimp Banh Cuon",
  "description": "A briny and light Vietnamese dish featuring shrimp and 00-flour, perfect for a post-workout meal. This dish is tagine-cooked and Buddhist-temple-friendly.",
  "cuisine": "Vietnamese",
  "diet": [
    "pescatarian",
    "gluten-free"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "00-flour",
      "amount": "1 cup",
      "notes": "also known as caputo flour"
    },
    {
      "name": "shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "lime juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "grated ginger",
      "amount": "1 teaspoon"
    },
    {
      "name": "chopped scallions",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "coconut oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "water",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "In a large mixing bowl, combine 00-flour and salt.",
    "Gradually add in water and mix until a smooth dough forms.",
    "Knead the dough for 5 minutes until it becomes elastic.",
    "Divide the dough into small balls and roll out each ball into a thin circle.",
    "In a separate pan, heat coconut oil over medium heat.",
    "Add grated ginger and cook for 1 minute until fragrant.",
    "Add shrimp and cook until pink and fully cooked.",
    "In a small bowl, whisk together fish sauce and lime juice.",
    "Add the cooked shrimp to the dough circles and drizzle with the fish sauce mixture.",
    "Top with chopped scallions and serve immediately."
  ],
