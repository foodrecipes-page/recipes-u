  "ingredients": [
    {
      "name": "white sauerkraut",
      "amount": "1 cup",
      "notes": "drained and rinsed"
    },
    {
      "name": "plain yogurt",
      "amount": "1 cup"
    },
    {
      "name": "water",
      "amount": "1/2 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "cumin powder",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "coriander powder",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "garam masala powder",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "white bread",
      "amount": "2 slices",
      "notes": "for toast"
    },
    {
      "name": "butter",
      "amount": "1 tablespoon"
    },
    {
      "name": "active dry yeast",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "In a blender, combine the sauerkraut, yogurt, water, salt, cumin powder, coriander powder, and garam masala powder.",
    "Blend the mixture on high speed until smooth and creamy.",
    "Heat the butter in a small pan over medium heat.",
    "Add the yeast to the melted butter and stir until dissolved.",
    "Add the yeast mixture to the blender and blend until well combined.",
    "Toast the bread until lightly browned.",
    "Cut the toast into small cubes and set aside.",
    "Pour the lassi mixture into glasses and top with toasted bread cubes.",
    "Serve immediately and enjoy."
  ],
