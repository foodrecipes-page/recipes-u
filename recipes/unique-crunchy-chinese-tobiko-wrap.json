    },
    {
      "name": "soy sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "sesame oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "sesame seeds",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "Arrange the ssam wrap pieces on a baking sheet lined with parchment paper",
    "Top each ssam wrap piece with a spoonful of chicken breast, some sliced yunnan mushrooms, and a sprinkle of green onions",
    "Drizzle the soy sauce and sesame oil over the filling",
    "Sprinkle the sesame seeds over the top of each wrap",
    "Bake the wraps in the preheated oven for 10 minutes, or until crispy and golden brown",
    "Remove the wraps from the oven and top each one with a spoonful of tobiko",
    "Serve the wraps immediately, garnished with additional green onions if desired"
  ],
