  "instructions": [
    "Rinse the soaked white beans and cook them in boiling water until tender.",
    "Heat the olive oil in a pan over medium heat.",
    "Add the chopped onion and cook until translucent.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the berbere spice, salt, and black pepper, and stir well.",
    "Add the cooked white beans to the pan and stir to combine.",
    "Squeeze the lemon juice over the beans and stir well.",
    "Simmer the mixture for 10 minutes, stirring occasionally.",
    "Taste and adjust the seasoning as needed.",
    "Spoon the bean mixture into scallop shells and serve."
  ],
