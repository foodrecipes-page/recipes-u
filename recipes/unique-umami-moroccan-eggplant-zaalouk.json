{
  "title": "Unique Umami Moroccan Eggplant Zaalouk",
  "description": "A kid-friendly Moroccan dish featuring streaky bacon and eggplant, cooked in a clay pot and steamed in a bamboo steamer to create a grassy and creamy flavor profile.",
  "cuisine": "Moroccan",
  "diet": [],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "eggplant",
      "amount": "2 medium",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "streaky bacon",
      "amount": "6 slices",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "chopped fresh parsley",
      "amount": "1/4 cup",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large clay pot, cook the streaky bacon over medium heat until crispy.",
    "Remove the bacon from the pot and set aside, leaving the grease behind.",
    "Add the chopped onion to the pot and cook until translucent.",
    "Add the minced garlic to the pot and cook for an additional minute.",
    "Add the eggplant cubes to the pot and cook until they start to soften.",
    "Add the tomato paste, olive oil, paprika, salt, and black pepper to the pot and stir to combine.",
    "Return the cooked bacon to the pot and stir to combine.",
    "Transfer the pot to a bamboo steamer and steam for 20 minutes.",
    "Garnish with chopped fresh parsley and serve hot."
  ],
