    },
    {
      "name": "bean sprouts",
      "amount": "1 cup"
    },
    {
      "name": "chopped peanuts",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the iron teppan to 400 degrees Fahrenheit",
    "Cook the rice noodles according to package instructions and set aside",
    "In a small bowl, whisk together plum sauce, lime juice, and grated ginger",
    "Add the vegetable oil to the preheated teppan and swirl it around",
    "Add the shrimp to the teppan and cook for 2-3 minutes per side, until pink and fully cooked",
    "Add the bean sprouts to the teppan and cook for 1 minute, until tender",
    "Add the cooked noodles, plum sauce mixture, salt, and pepper to the teppan and stir-fry for 2 minutes",
    "Transfer the pad thai to a serving platter and top with chopped peanuts"
  ],
