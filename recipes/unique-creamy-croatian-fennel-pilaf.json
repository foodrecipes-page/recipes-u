  "ingredients": [
    {
      "name": "fennel bulb",
      "amount": "2 medium",
      "notes": "chopped"
    },
    {
      "name": "nuka-pickle",
      "amount": "1 cup",
      "notes": "diced"
    },
    {
      "name": " Arborio rice",
      "amount": "1 cup"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "yeast",
      "amount": "1 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "grana padano cheese",
      "amount": "1 cup",
      "notes": "shaved"
    },
    {
      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "cooked and diced"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large saucepan over medium heat.",
    "Add the chopped fennel and cook until it is tender, about 5 minutes.",
    "Add the garlic and cook for an additional minute.",
    "Add the Arborio rice and cook for 1-2 minutes, stirring constantly.",
    "Add the chicken broth, yeast, and nuka-pickle, and bring to a boil.",
    "Reduce the heat to low, cover, and simmer for 20 minutes.",
    "Stir in the grana padano cheese until melted and creamy.",
    "Add the cooked chicken breast and stir to combine.",
    "Season with salt and pepper to taste.",
    "Serve hot and enjoy."
  ],
