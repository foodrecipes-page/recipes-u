{
  "title": "Untamed Syrian Chicken Kebabs",
  "description": "Earthy and snappy Syrian dish featuring tahini, served in a bento box, perfect for a diabetic friendly meal",
  "cuisine": "Syrian",
  "diet": [
    "diabetic-friendly"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "tahini",
      "amount": "1/2 cup"
    },
    {
      "name": "lemon juice",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit",
    "In a large bowl, whisk together tahini, lemon juice, olive oil, garlic, paprika, salt, and black pepper",
    "Add the chicken to the bowl and toss to coat with the tahini mixture",
    "Thread the chicken onto skewers, leaving a small space between each piece",
    "Grill the chicken for 10-12 minutes, or until cooked through",
    "Serve the chicken in a bento box with a side of parsley",
    "Drizzle any remaining tahini sauce over the top of the chicken",
    "Serve immediately and enjoy"
  ],
