  "ingredients": [
    {
      "name": "cherries",
      "amount": "2 cups",
      "notes": "fresh or frozen"
    },
    {
      "name": "orange juice",
      "amount": "1 cup"
    },
    {
      "name": "sugar",
      "amount": "1 cup"
    },
    {
      "name": "flour",
      "amount": "2 cups"
    },
    {
      "name": "butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "eggs",
      "amount": "2"
    },
    {
      "name": "milk",
      "amount": "1 cup"
    },
    {
      "name": "vanilla extract",
      "amount": "1 tsp"
    }
  ],
  "instructions": [
    "Preheat the wood-fired oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together the flour, sugar, and eggs.",
    "Add the melted butter, orange juice, and milk to the bowl and mix until well combined.",
    "Gently fold in the cherries.",
    "Pour the mixture into a Dutch oven.",
    "Bake for 40 minutes or until the edges are golden brown and the center is still slightly gooey.",
    "Remove from the oven and let cool for 10 minutes.",
    "Drizzle with vanilla extract and serve warm."
  ],
