      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "sesame oil",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the sesame oil in a large skillet over medium-high heat",
    "Add the minced garlic and cook for 1 minute until fragrant",
    "Add the thinly sliced veal and cook for 3-4 minutes per side until browned",
    "Add the chopped nuka-pickle, fish sauce, lime juice, brown sugar, and gluten-free soy sauce to the skillet",
    "Stir everything together to combine and cook for an additional 2 minutes",
    "Reduce the heat to medium-low and stir in the butter until melted and smooth",
    "Season with black pepper to taste",
    "Serve the veal moo ping hot, garnished with additional nuka-pickle and lime wedges if desired"
  ],
