      "notes": "high quality, bronze cut"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "finely chopped"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "finely chopped"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "finely chopped"
    },
    {
      "name": "malty beer",
      "amount": "1 cup"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups"
    },
    {
      "name": "tomato paste",
      "amount": "2 tbsp"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large wok over medium heat.",
    "Add the chopped onion, carrots, and celery and cook until the vegetables are tender, about 10 minutes.",
    "Add the malty beer, vegetable broth, and tomato paste to the wok and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 10 minutes.",
    "Add the rigatoni to the wok and cook until it is al dente, about 8 minutes.",
    "Season the pasta with salt and black pepper to taste.",
    "Stir in the chopped parsley and serve hot.",
    "Serve immediately and enjoy."
  ],
