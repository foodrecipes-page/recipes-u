  "instructions": [
    "heat the olive oil in a large pan over medium-high heat.",
    "add the onion and cook until translucent, about 5 minutes.",
    "add the garlic and cook for 1 minute.",
    "add the minced steak and cook, breaking it up with a spoon, until it is no longer pink, about 5 minutes.",
    "add the cumin, paprika, salt, and black pepper, and stir to combine.",
    "add the fermented turnip, chopped parsley, lemon juice, and water, and stir to combine.",
    "add the sour cherry and stir to combine.",
    "reduce heat to low and simmer, covered, for 10 minutes.",
    "serve hot, garnished with additional parsley if desired.",
    "transfer the tagine to a slate tile vessel and serve.",
    "cover the vessel with a lid or foil to keep warm."
