      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "water",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Grind the peanuts into a fine paste using a food processor.",
    "Heat the lemon juice in a saucepan over low heat.",
    "Add the garlic, ginger, berbere spice, salt, and black pepper to the saucepan and stir well.",
    "Add the peanut paste to the saucepan and stir until well combined.",
    "Gradually add the water to the saucepan and stir until the mixture forms a dense paste.",
    "Remove the saucepan from the heat and let it cool.",
    "Shape the paste into small nigiri-shaped forms.",
    "Serve the azifa at room temperature or chilled."
