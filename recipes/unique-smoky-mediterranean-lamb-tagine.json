    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit.",
    "Season the lamb pieces with smoked paprika, salt, black pepper, and dried oregano.",
    "Heat the olive oil in the copper pot over medium-high heat and sear the lamb until browned on all sides.",
    "Add the garlic-infused oil to the pot and stir to combine.",
    "Cover the pot with a lid and transfer it to the preheated oven.",
    "Braise the lamb for 2.5 hours, or until tender and falling apart.",
    "Remove the pot from the oven and stir in the shredded Gruyere cheese until melted and well combined.",
    "Serve the lamb hot, garnished with chopped fresh parsley."
  ],
