  "instructions": [
    "Preheat the oven to 375 degrees.",
    "Roll out the puff pastry and cut it into small squares.",
    "Heat the olive oil in a large skillet over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the cumin and coriander and cook for 1 minute.",
    "Add the pineapple chunks and cook until they are caramelized.",
    "Add the lemon juice and salt and stir to combine.",
    "Place the puff pastry squares on top of the pineapple mixture and bake for 25 minutes."
  ],
