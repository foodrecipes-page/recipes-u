{
  "title": "Unique Smoky Brazilian Tempeh Skewers",
  "description": "Charred and springy Brazilian dish featuring tempeh, this recipe is perfect for a hangover cure and is ayurvedic-sattvic-friendly, with a smoky flavor from the wok-hei technique",
  "cuisine": "Brazilian",
  "diet": [
    "vegetarian",
    "vegan",
    "gluten-free"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "tempeh",
      "amount": "1 block",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "coconut oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "onion powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "bamboo skewers",
      "amount": "10-12 skewers"
    }
  ],
  "instructions": [
    "Preheat a grill or grill pan to medium-high heat",
    "In a large bowl, whisk together coconut oil, lime juice, smoked paprika, garlic powder, onion powder, salt, and black pepper",
    "Add the tempeh pieces to the bowl and toss to coat with the marinade",
    "Thread 3-4 tempeh pieces onto each bamboo skewer",
    "Brush the grill or grill pan with a small amount of coconut oil to prevent sticking",
    "Grill the skewers for 3-4 minutes per side, or until charred and cooked through",
    "Repeat with the remaining skewers",
    "Serve the skewers hot, garnished with fresh cilantro or scallions if desired"
  ],
