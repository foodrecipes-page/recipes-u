  "ingredients": [
    {
      "name": "pork shoulder",
      "amount": "2 pounds",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "shortening",
      "amount": "1/4 cup"
    },
    {
      "name": "render fat",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "carrot",
      "amount": "2 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "potato",
      "amount": "2 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit.",
    "In a large cataplana, heat the shortening over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the pork cubes and cook until browned on all sides, about 10 minutes.",
    "Add the chopped carrot and potato, salt, black pepper, and paprika, and stir to combine.",
    "Cover the cataplana and transfer to the preheated oven.",
    "Bake for 2 hours, or until the pork is tender and the vegetables are cooked through.",
    "Remove the cataplana from the oven and let cool for 10 minutes before serving."
  ],
