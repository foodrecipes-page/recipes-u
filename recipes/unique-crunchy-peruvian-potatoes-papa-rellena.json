    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Boil the potatoes in salted water until they are tender.",
    "Drain the potatoes and let them cool.",
    "In a pan, heat the oil and fry the potatoes until they are golden brown.",
    "In a bowl, mix the ground beef, onion, garlic, salt, and pepper.",
    "Add the beaten egg to the bowl and mix well.",
    "Stuff each potato half with the beef mixture and top with crushed peanut brittle.",
    "Dip each stuffed potato in the beaten egg and then coat with crushed peanut brittle.",
    "Fry the coated potatoes in hot oil until they are golden brown.",
    "Drain the potatoes on paper towels and serve hot."
  ],
