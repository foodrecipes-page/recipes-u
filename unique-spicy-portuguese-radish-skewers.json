      "name": "radish",
      "amount": "1 large radish, thinly sliced",
      "notes": "any color radish works well"
    },
    {
      "name": "unique chili peppers",
      "amount": "2-3 peppers, seeded and chopped",
      "notes": "use gloves when handling"
    },
    {
      "name": "portuguese sausage",
      "amount": "1/2 pound, sliced",
      "notes": "look for linguiça or chouriço"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "use a good quality oil"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon",
      "notes": "or to taste"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon",
      "notes": "smoked or sweet work well"
    },
    {
      "name": "salt",
      "amount": "to taste",
      "notes": "use flaky salt if possible"
    },
    {
      "name": "black pepper",
      "amount": "to taste",
      "notes": "freshly ground is best"
    }
  ],
  "instructions": [
    "Preheat grill to medium-high heat.",
    "Thread radish, sausage, and peppers onto skewers, leaving a little space between each piece.",
    "In a small bowl, mix together olive oil, garlic powder, paprika, salt, and pepper.",
    "Brush the mixture onto both sides of the skewers.",
    "Grill for 8-10 minutes, turning occasionally, until the sausage is cooked through and the radish is tender.",
    "Remove from heat and serve immediately."
  ],
